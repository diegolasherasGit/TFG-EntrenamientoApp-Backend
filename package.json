{
  "name": "tfg-entrenamientoapp-backend",
  "version": "1.1.6",
  "type": "module",
  "description": "Repositorio Backend TFG Desarrollo del sistema base y módulo de gestión de entrenamientos para una aplicación móvil de escalada",
  "main": "src/index.js",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "nodemon src/index.js",
    "seed": "node src/scripts/seed.js",
    "seed:maestro": "node src/scripts/seed.maestro.js",
    "seed:maestro:docker": "docker compose -f docker-compose.dev.yml exec backend pnpm run seed:maestro",
    "start": "node src/index.js",
    "lint": "eslint \"src/**/*.js\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:docker": "docker compose -f docker-compose.dev.yml exec backend pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegolasheras/TFG-EntrenamientoApp-Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/diegolasheras/TFG-EntrenamientoApp-Backend/issues"
  },
  "homepage": "https://github.com/diegolasheras/TFG-EntrenamientoApp-Backend#readme",
  "dependencies": {
    "@sentry/node": "^10.56.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^17.6.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}