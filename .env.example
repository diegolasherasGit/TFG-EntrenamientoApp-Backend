# Backend Configuration
NODE_ENV=development
PORT=3000
BIND_ADDRESS=0.0.0.0
BACKEND_EXTERNAL_PORT=3000

# Puerto público HTTPS en producción (docker-compose.prod.yml).
# El servidor puede tener 80/443 ocupados por otro proxy compartido; usa el
# puerto que os asignen. Requiere certificados en ./certs/ (ver nginx/default.conf).
BACKEND_HTTPS_PORT=3443

# Database Configuration
# MongoDB SIEMPRE corre en Docker (incluidas las pruebas). El backend y los scripts
# se ejecutan dentro del contenedor, donde el host de Mongo es el servicio "mongo".
MONGO_URI=mongodb://mongo:27017/entrenamiento_db
# Base de datos dedicada que usan los tests (no toca los datos de desarrollo)
MONGO_TEST_DB=test_db
MONGO_EXTERNAL_PORT=27017

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email (recuperación de contraseña y verificación OTP)
# Sin configurar, en desarrollo se usa Ethereal y el enlace aparece en la consola del backend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Sentry (monitorización de errores). Sin DSN, Sentry queda desactivado.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# URL pública base del backend (para construir URLs de archivos subidos sin confiar en cabeceras del cliente)
PUBLIC_URL=
