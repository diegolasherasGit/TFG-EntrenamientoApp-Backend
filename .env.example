# Backend Configuration
NODE_ENV=development
PORT=3000
BIND_ADDRESS=0.0.0.0
BACKEND_EXTERNAL_PORT=3000

# Database Configuration
# Docker Compose (dentro del contenedor backend): hostname "mongo"
MONGO_URI=mongodb://mongo:27017/entrenamiento_db
# Si ejecutas seed/scripts desde tu PC (pnpm run seed:maestro), usa localhost:
# MONGO_URI=mongodb://localhost:27017/entrenamiento_db
MONGO_EXTERNAL_PORT=27017

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=90d

# Email (recuperación de contraseña y verificación OTP)
# Sin configurar, en desarrollo se usa Ethereal y el enlace aparece en la consola del backend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
